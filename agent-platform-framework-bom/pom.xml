<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentplatform</groupId>
        <artifactId>agent-platform</artifactId>
        <version>1.5.0</version>
    </parent>

    <artifactId>agent-platform-framework-bom</artifactId>
    <packaging>pom</packaging>
    <name>Agent Platform Framework BOM</name>
    <description>
        框架的版本清单：宿主 import 一次即可锁全套版本，不必逐个写 version。
        这也是"框架与平台可同时分发"的配套设施——版本对齐是分发的隐性成本。
    </description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.agentplatform</groupId>
                <artifactId>agent-platform-framework-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentplatform</groupId>
                <artifactId>agent-platform-framework-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentplatform</groupId>
                <artifactId>agent-platform-framework-springai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentplatform</groupId>
                <artifactId>agent-platform-framework-rag</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentplatform</groupId>
                <artifactId>agent-platform-framework-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.agentplatform</groupId>
                <artifactId>agent-platform-framework-starter-springai</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
