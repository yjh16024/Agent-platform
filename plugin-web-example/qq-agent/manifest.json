{
    "id":  "qq_agent",
    "name":  "QQ 助手",
    "version":  "2.3.0",
    "description":  "接入 NapCat，让智能体接管一个 QQ 号：监听私聊/群聊、按白名单回复、模拟真人打字节奏。",
    "slot":  "global.overlay",
    "entry":  "client.js",
    "style":  "style.css",
    "main":  "main.js",
    "isolate":  true,
    "order":  60,
    "scope":  "global",
    "config":  [
                   {
                       "key":  "enabled",
                       "label":  "启用接管",
                       "type":  "boolean",
                       "default":  false,
                       "description":  "打开后才会连 NapCat 并开始回消息"
                   },
                   {
                       "key":  "agentId",
                       "label":  "使用的智能体",
                       "type":  "agent",
                       "default":  "",
                       "description":  "由哪个智能体回复。人格与系统提示词请到「智能体」页配置，这里只选人"
                   },
                   {
                       "key":  "napcatWs",
                       "label":  "NapCat WebSocket 地址",
                       "type":  "text",
                       "default":  "ws://127.0.0.1:3001"
                   },
                   {
                       "key":  "napcatToken",
                       "label":  "Access Token",
                       "type":  "text",
                       "default":  "",
                       "description":  "与 NapCat 网络配置里填的一致"
                   },
                   {
                       "key":  "selfUin",
                       "label":  "接管的 QQ 号",
                       "type":  "number",
                       "default":  0
                   },
                   {
                       "key":  "privateWhitelist",
                       "label":  "私聊白名单",
                       "type":  "text",
                       "default":  "",
                       "description":  "QQ 号，逗号分隔。留空 = 忽略所有私聊（默认安全）"
                   },
                   {
                       "key":  "groupWhitelist",
                       "label":  "群白名单",
                       "type":  "text",
                       "default":  "",
                       "description":  "群号，逗号分隔。群里只在被 @ 时回复"
                   },
                   {
                       "key":  "replyPrivate",
                       "label":  "私聊回复概率",
                       "type":  "number",
                       "default":  0.9,
                       "min":  0,
                       "max":  1,
                       "step":  0.05,
                       "description":  "不是每条都回才像真人；0.9 表示约 10% 故意不回"
                   },
                   {
                       "key":  "replyGroup",
                       "label":  "群聊回复概率",
                       "type":  "number",
                       "default":  0.55,
                       "min":  0,
                       "max":  1,
                       "step":  0.05
                   },
                   {
                       "key":  "silenceEnabled",
                       "label":  "启用沉默期",
                       "type":  "boolean",
                       "default":  false,
                       "description":  "开启后会周期性「在线但不回任何人」，模拟真人在忙。调试期间务必关闭 —— 每次重启都可能命中一段静默"
                   },
                   {
                       "key":  "silenceMinMinutes",
                       "label":  "静默最短（分钟）",
                       "type":  "number",
                       "default":  20,
                       "description":  "仅在启用沉默期时生效"
                   },
                   {
                       "key":  "silenceMaxMinutes",
                       "label":  "静默最长（分钟）",
                       "type":  "number",
                       "default":  90
                   },
                   {
                       "key":  "maxSegments",
                       "label":  "分段发送上限",
                       "type":  "number",
                       "default":  3,
                       "min":  1,
                       "max":  6,
                       "description":  "长回复拆成几条发，中间停顿 0.8~2.5 秒"
                   },
                   {
                       "key":  "typing",
                       "label":  "模拟「正在输入」",
                       "type":  "boolean",
                       "default":  true
                   },
                   {
                       "key":  "stickerDir",
                       "label":  "表情包目录",
                       "type":  "text",
                       "default":  "",
                       "description":  "本机图片目录（png/jpg/gif/webp）。文件名可带情绪标签：开心_01.png、无语_02.jpg，会优先匹配"
                   },
                   {
                       "key":  "stickerChance",
                       "label":  "附带表情的概率",
                       "type":  "number",
                       "default":  0.25,
                       "min":  0,
                       "max":  1,
                       "step":  0.05,
                       "description":  "0 = 不发；0.25 表示约四分之一的回复会补一张表情"
                   },
                   {
                       "key":  "voiceChance",
                       "label":  "用语音回复的概率",
                       "type":  "number",
                       "default":  0,
                       "min":  0,
                       "max":  1,
                       "step":  0.05,
                       "description":  "0 = 全文字。触发时还要看字数是否低于下一项的上限"
                   },
                   {
                       "key":  "voiceMaxChars",
                       "label":  "语音的最大字数",
                       "type":  "number",
                       "default":  60,
                       "min":  10,
                       "max":  300,
                       "step":  5,
                       "description":  "超过这个字数就不转语音（长文念出来没人听）"
                   },
                   {
                       "key":  "ttsBaseUrl",
                       "label":  "TTS 接口地址",
                       "type":  "text",
                       "default":  "",
                       "description":  "OpenAI 兼容的 /audio/speech，例如 https://api.openai.com/v1 或你的中转地址"
                   },
                   {
                       "key":  "ttsApiKey",
                       "label":  "TTS 密钥",
                       "type":  "text",
                       "default":  ""
                   },
                   {
                       "key":  "ttsModel",
                       "label":  "TTS 模型",
                       "type":  "text",
                       "default":  "tts-1"
                   },
                   {
                       "key":  "ttsVoice",
                       "label":  "音色",
                       "type":  "text",
                       "default":  "alloy",
                       "description":  "各家不同：alloy / nova / shimmer（OpenAI），或服务商自定义音色 ID"
                   },
                   {
                       "key":  "visionEnabled",
                       "label":  "看图（多模态）",
                       "type":  "boolean",
                       "default":  true,
                       "description":  "收到图片时上传给平台，由多模态模型理解。需要智能体绑定的模型本身支持视觉"
                   },
                   {
                       "key":  "debounceSeconds",
                       "label":  "消息接收窗口期（秒）",
                       "type":  "number",
                       "default":  3,
                       "min":  0,
                       "max":  30,
                       "step":  1,
                       "description":  "收到消息后等这么久再回；期间又收到消息就重置计时并合并，直到安静满窗才回复。0 = 关闭"
                   },
                   {
                       "key":  "segmentRegex",
                       "label":  "分段正则",
                       "type":  "text",
                       "default":  ".*?[。？！~…]+|.+$",
                       "description":  "匹配一个句子的正则（不是分割符）。默认按句号/问号/叹号/波浪号/省略号切分；写错会自动回落默认值"
                   },
                   {
                       "key":  "stripMarkdown",
                       "label":  "去掉 Markdown 标记",
                       "type":  "boolean",
                       "default":  true,
                       "description":  "QQ 不渲染 Markdown，模型返回的 **粗体**、- 列表、| 表格 | 会变成一堆符号。开启后转成纯文本"
                   },
                   {
                       "key":  "selfManageEnabled",
                       "label":  "启用自我管理",
                       "type":  "boolean",
                       "default":  false,
                       "description":  "会真的改账号资料（头像/签名/昵称），并按 7~30 天等随机冷却执行 —— 频繁改资料是异常账号的典型特征"
                   },
                   {
                       "key":  "avatarDir",
                       "label":  "头像池目录（可选兜底）",
                       "type":  "text",
                       "default":  "",
                       "description":  "本机图片目录。留空也没关系 —— 模型换头像时会自己调 image_gen 生成或 web_search 搜图；这里只是工具调用失败时的兜底，按文件名关键词匹配"
                   },
                   {
                       "key":  "proactiveGapHoursMin",
                       "label":  "主动发言最短间隔（小时）",
                       "type":  "number",
                       "default":  2,
                       "min":  0.1,
                       "max":  720,
                       "step":  0.5,
                       "description":  "两次主动发言至少隔这么久。实际间隔在最短与最长之间随机 —— 固定间隔会像闹钟一样准点出现"
                   },
                   {
                       "key":  "proactiveGapHoursMax",
                       "label":  "主动发言最长间隔（小时）",
                       "type":  "number",
                       "default":  8,
                       "min":  0.1,
                       "max":  720,
                       "step":  0.5,
                       "description":  "默认 8 小时 ≈ 一天 3 次；调大更安静。最终还受「每次真发的概率」与「对方安静多久才考虑」两道闸"
                   },
                   {
                       "key":  "selfCheckHoursMin",
                       "label":  "自我检视最短间隔（小时）",
                       "type":  "number",
                       "default":  2,
                       "min":  1,
                       "max":  72,
                       "step":  1,
                       "description":  "每隔这么久问一次模型「要不要改资料」。模型多数时候会说不改，间隔太短只是白烧 token"
                   },
                   {
                       "key":  "selfCheckHoursMax",
                       "label":  "自我检视最长间隔（小时）",
                       "type":  "number",
                       "default":  6,
                       "min":  1,
                       "max":  168,
                       "step":  1
                   },
                   {
                       "key":  "proactiveEnabled",
                       "label":  "启用主动发言",
                       "type":  "boolean",
                       "default":  false,
                       "description":  "每隔 12~48 小时，从「最近 48 小时聊过的人」里挑一个主动说一句话。没人聊过就不会发"
                   },
                   {
                       "key":  "proactivePeek",
                       "label":  "主动发言前先看一眼热门",
                       "type":  "boolean",
                       "default":  false,
                       "description":  "开启后先取几条 B 站热门当话题素材。会多一次抓取与更长上下文（更贵），也更容易像营销号；需要智能体挂载「网页内容与热门」插件"
                   },
                   {
                       "key":  "proactivePeekCount",
                       "label":  "看几条热门",
                       "type":  "number",
                       "default":  5,
                       "min":  1,
                       "max":  20,
                       "step":  1
                   },
                   {
                       "key":  "proactiveQuietMinutes",
                       "label":  "对方安静多久才考虑",
                       "type":  "number",
                       "default":  15,
                       "min":  1,
                       "max":  720,
                       "step":  1,
                       "description":  "单位分钟。正在聊天时不要主动插话，等对方安静满这么久才开始考虑"
                   },
                   {
                       "key":  "proactiveChance",
                       "label":  "每次检查真发的概率",
                       "type":  "number",
                       "default":  0.35,
                       "min":  0,
                       "max":  1,
                       "step":  0.05,
                       "description":  "0.35 表示多数检查都会放弃 —— 行为才不像闹钟。设为 1 就是每次检查都发"
                   },
                   {
                       "key":  "diaryEnabled",
                       "label":  "让她自己写日记",
                       "type":  "boolean",
                       "default":  true,
                       "description":  "3~12 小时随机检查一次，只有 30% 会真写，模型也可以回「不写」。日记存在插件数据目录的 diary.jsonl（纯文本，可直接打开 / grep / 手改）"
                   },
                   {
                       "key":  "impressionEnabled",
                       "label":  "记「印象」",
                       "type":  "boolean",
                       "default":  true,
                       "description":  "聊够 20 句后用一句话概括「这个人是什么样」，每周最多重写一次。和事实记忆（他养了只猫）是两层，这一层是判断"
                   },
                   {
                       "key":  "proactiveWithinHours",
                       "label":  "主动发言的候选范围（小时）",
                       "type":  "number",
                       "default":  48,
                       "min":  1,
                       "max":  720,
                       "step":  1,
                       "description":  "只对最近这么多小时内聊过的人主动，避免骚扰陌生人"
                   },
                   {
                       "key":  "riskAcknowledged",
                       "label":  "我已了解账号风险",
                       "type":  "boolean",
                       "default":  false,
                       "description":  "接管个人号违反 QQ 用户协议、有封号风险。勾选前不会连接。请用你自己的号测试，别用主号"
                   },
                   {
                       "key":  "rateLimitPerMinute",
                       "label":  "每会话每分钟调用上限",
                       "type":  "number",
                       "default":  6,
                       "min":  0,
                       "max":  120,
                       "step":  1,
                       "description":  "成本护栏。按会话计数，超过就丢弃（不排队）。0 = 不限制"
                   },
                   {
                       "key":  "groupMemberWhitelist",
                       "label":  "群成员白名单",
                       "type":  "text",
                       "default":  "",
                       "description":  "QQ 号，逗号分隔。留空 = 群内不限制发送人；填写后只有名单里的人能触发回复"
                   },
                   {
                       "key":  "qzoneEnabled",
                       "label":  "允许发说说",
                       "type":  "boolean",
                       "default":  false,
                       "description":  "模型在回复里写 [说说 内容] 时发布动态。默认关 —— 一发就是所有人都能看到"
                   },
                   {
                       "key":  "qzoneUgcRight",
                       "label":  "说说可见范围",
                       "type":  "number",
                       "default":  1,
                       "min":  0,
                       "max":  1,
                       "step":  1,
                       "description":  "0 = 公开，1 = 仅自己可见（默认安全）。第一次开这个功能建议先 1，确认内容没问题再改 0"
                   },
                   {
                       "key":  "qzoneCooldownHours",
                       "label":  "说说冷却（小时）",
                       "type":  "number",
                       "default":  24,
                       "min":  1,
                       "max":  720,
                       "step":  1,
                       "description":  "两次说说之间至少隔这么久，避免刷屏"
                   },
                   {
                       "key":  "selfStatusEnabled",
                       "label":  "自动切换在线状态",
                       "type":  "boolean",
                       "default":  false,
                       "description":  "白天（8~23 点）在线，其余时间「离开」。只在状态变化时调用，不会频繁切换"
                   }
               ]
}